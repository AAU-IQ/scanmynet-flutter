# Internal SDD planning/spec artifacts — not for package consumers.
# These also referenced a committed (now rotated) API key; keep them off pub.dev.
docs/superpowers/
.superpowers/

# Transient staging area for verifying a Bitrise framework build. Never ship it.
ios_sdk_ignore_for_github_for_test_and_check_only/

# A .pubignore OVERRIDES .gitignore in this directory, so the build artifacts
# normally excluded by .gitignore must be repeated here — otherwise pub bundles
# them (e.g. build/test_cache holds ~90 MB of Dart compilation cache).
build/
.dart_tool/
