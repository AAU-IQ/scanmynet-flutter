# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The bundled ScanMyNet.xcframework was compiled with library evolution
# (BUILD_LIBRARY_FOR_DISTRIBUTION=YES) against these Swift dependencies. Flutter's
# default CocoaPods build compiles them WITHOUT library evolution, which strips
# the resilient witness symbols ScanMyNet links against and crashes the app at
# launch with a dyld "Symbol not found" error. Rebuild them the same way to match
# the framework's ABI. (Mirrors the post_install in scanmynet-ios/Podfile.)
SCANMYNET_LIBRARY_EVOLUTION_PODS = %w[Alamofire XMLCoder BlueSocket NDT7].freeze

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # permission_handler: enable the permissions this app actually uses. These
      # macros default to 0 (disabled) in permission_handler_apple, so without
      # them the location strategy is compiled out and NO system permission
      # dialog ever appears — Permission.location.request() just returns denied.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      %w[PERMISSION_LOCATION=1 PERMISSION_LOCATION_WHENINUSE=1].each do |macro|
        defs << macro unless defs.include?(macro)
      end
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

      # The bundled ScanMyNet.xcframework was compiled with library evolution
      # against these Swift deps; rebuild them the same way or the app crashes at
      # launch with a dyld "Symbol not found" error (see README "iOS setup").
      if SCANMYNET_LIBRARY_EVOLUTION_PODS.include?(target.name)
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end
  end
end
